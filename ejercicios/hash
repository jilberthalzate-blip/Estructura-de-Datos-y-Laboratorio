import hashlib
import time

target = 'ef797c8118f02dfb649607dd5d3f8c7623048c9c063d532cc95c5ed7a898a64f'

inicio = time.time()  # ← empieza el cronómetro

for i in range(100_000_000):
    candidato = f'{i:08d}'
    hash = hashlib.sha256(candidato.encode()).hexdigest()
    if hash == target:
        fin = time.time()  # ← para el cronómetro
        print(f'Clave: {candidato}')
        print(f'Intentos: {i+1:,}')
        print(f'Tiempo: {fin - inicio:.4f} seg')
        print(f'Velocidad: {(i+1)/(fin-inicio):,.0f} hashes/seg')
        break